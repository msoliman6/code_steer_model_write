# Copy to .env. One key is enough to start; the fake backend needs none.
CSMW_BACKEND=anthropic            # anthropic | agent_sdk | litellm | claude_cli | codex_cli | fake
CSMW_MODEL_A=claude-sonnet-5      # the author side
CSMW_MODEL_B=gpt-5.4-mini         # the checker side (a different vendor, rule 3)
CSMW_MODE=light                   # detailed | light | auto
CSMW_ROUNDS=2
CSMW_RUNS_DIR=runs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# FAKE_MODELS=1                   # every model call answered by the fake backend, zero tokens
